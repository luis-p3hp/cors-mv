{
  "manifest_version": 3,
  "name": "CORS-MV",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "Bidirectionally bridges audio between two browser meeting tabs (Google Meet, Microsoft Teams, Zoom web client) by injecting a virtual microphone into each.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://*.teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://teams.cloud.microsoft/*",
    "https://zoom.us/*",
    "https://*.zoom.us/*",
    "https://zoom.com/*",
    "https://*.zoom.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CORS-MV"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://*.teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://zoom.us/*",
        "https://*.zoom.us/*",
        "https://zoom.com/*",
        "https://*.zoom.com/*"
      ],
      "js": [
        "page-inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://*.teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://zoom.us/*",
        "https://*.zoom.us/*",
        "https://zoom.com/*",
        "https://*.zoom.com/*"
      ],
      "js": [
        "content-relay.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ]
}
